{
    "name": "metadesignsolutions/room-ai-service",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "predis/predis": "^2.2",
        "intervention/image-laravel": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "dev": "php artisan serve"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "description": "AI-powered room visualization service using Laravel and React TypeScript",
    "license": "proprietary",
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
